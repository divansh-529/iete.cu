# Copy to .env and adjust. All settings use the IETE_ prefix (see app/core/config.py).
IETE_DATABASE_URL=postgresql+psycopg://iete:iete_dev_password@localhost:5433/iete
IETE_COOKIE_SECURE=false          # true in production (HTTPS only)
IETE_FRONTEND_BASE_URL=http://localhost:5173
IETE_SESSION_IDLE_MINUTES=120
IETE_SESSION_ABSOLUTE_DAYS=7
# Production only: shared with the website's /api proxy (docs/09-deployment.md). Leave empty locally.
IETE_PROXY_SECRET=
# File storage over the S3 API (any S3-compatible provider). Leave empty and uploads say
# "not set up yet" while the rest of the portal keeps working.
IETE_S3_ENDPOINT_URL=
IETE_S3_BUCKET=
IETE_S3_ACCESS_KEY_ID=
IETE_S3_SECRET_ACCESS_KEY=
IETE_S3_REGION=auto
