// Cloudflare Worker that serves the portal (docs/09-deployment.md).
// Build first (npm run build), then `npx wrangler deploy` from this folder.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iete-cu",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Any path that is not a file (e.g. /app/org) gets index.html, so the React router handles it.
    "not_found_handling": "single-page-application",
    // Only API calls run the Worker; everything else is served straight from the assets.
    "run_worker_first": ["/api/*"]
  },
  // BACKEND_URL and PROXY_SECRET are set in the dashboard; don't wipe them on deploy.
  "keep_vars": true,
  "observability": { "enabled": true }
}
